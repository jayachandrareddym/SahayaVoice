# ── Sarvam AI (STT + TTS for Indian languages) ───────────────────────────
# Get your key at https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# ── LLM Backend ──────────────────────────────────────────────────────────
# Options: ollama | openai | watsonx
LLM_BACKEND=ollama

# Ollama (default, local): install from https://ollama.com and run `ollama pull llama3`
LLM_API_URL=http://localhost:11434/api/chat
LLM_MODEL=llama3

# OpenAI-compatible endpoint (set LLM_BACKEND=openai)
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...

# IBM watsonx.ai (set LLM_BACKEND=watsonx – requires Member 6 integration)
# WATSONX_API_KEY=...
# WATSONX_PROJECT_ID=...
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
