# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Groq (optional — much faster LLM, free tier available) ──────────────────
GROQ_API_KEY=gsk_...

# ── ElevenLabs (optional — higher quality TTS) ──────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel (default)

# ── IBM watsonx.ai (Granite) ─────────────────────────────────────────────────
WATSONX_API_KEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── Backend selection ────────────────────────────────────────────────────────
# STT:  whisper_api | whisper_local
STT_BACKEND=whisper_api

# LLM:  openai | groq | watsonx
LLM_BACKEND=watsonx

# TTS:  openai | elevenlabs
TTS_BACKEND=openai

# ── Whisper local settings (only used when STT_BACKEND=whisper_local) ────────
WHISPER_MODEL=base

# ── LLM settings ─────────────────────────────────────────────────────────────
LLM_MODEL_OPENAI=gpt-4o-mini
LLM_MODEL_GROQ=llama-3.1-8b-instant
SYSTEM_PROMPT=You are a helpful, concise voice assistant. Keep responses under 3 sentences unless asked for more detail.

# ── SahayaVoice civic complaint engine ───────────────────────────────────────
# Default language for clarification prompts: kannada | hindi | english
SAHAYA_LANG=kannada
# Max clarification rounds before giving up
SAHAYA_MAX_CLARIFY=3

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=info
