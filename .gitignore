# SahayaVoice – .gitignore

# Environment / secrets – NEVER commit these
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Tool internals (Bob / Refact)
.refact/
.snapshots/

# Nested repo copy
SahayaVoice-main/
